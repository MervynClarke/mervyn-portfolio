# Contact form endpoint (Formspree / Resend)
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Tea Tasting (/TeaTasting) cloud sync — optional; app runs local-only without these.
# Supabase Dashboard → Project Settings → API. See src/teatasting/README.md.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
