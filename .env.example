# Contact form endpoint (Formspree / Resend)
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Tea Tasting (/TeaTasting) cloud sync — optional; the app runs local-only
# without these. Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_TEATASTING_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_TEATASTING_ANON_KEY

# Yoga Tracker (/YogaTracker) cloud sync — its own Supabase project, separate
# from Tea Tasting. Optional; the app runs local-only without these. Copy from
# the YogaTracker project's Settings → API. Screenshot reading needs no key
# (Tesseract WASM, vendored in /public/ocr — runs in the browser).
NEXT_PUBLIC_YOGA_SUPABASE_URL=https://YOUR_YOGA_PROJECT.supabase.co
NEXT_PUBLIC_YOGA_SUPABASE_ANON_KEY=YOUR_YOGA_ANON_KEY
